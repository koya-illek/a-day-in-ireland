{
  "name": "a-day-in-ireland",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p dist/client dist/server dist/.openai && cp -R out/. dist/client/ && cp platform/server-entry.js dist/server/index.js && cp platform/river-source.js dist/server/river-source.js && cp .openai/hosting.json dist/.openai/hosting.json",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "deploy:cloudflare:api": "wrangler deploy --config wrangler.api.toml",
    "deploy:cloudflare:pages": "wrangler pages deploy dist/client --project-name a-day-in-ireland --branch main"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "^15.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "satellite.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.4.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
